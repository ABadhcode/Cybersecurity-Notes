KEY TERMS : 
Service Provider: The component/server that provides the requested service or data.

Service Consumer: The component/client that requests and uses the service or data.

Request: Sent by the Service Consumer to the Service Provider using HTTP.

Response: Sent back by the Service Provider to the Service Consumer.

JSON: A commonly used data format for exchanging information between the two components.

Stateless: Each request is independent; the server does not need to remember the client's previous request.

//CODE EXAMPLE //

const express = require('express');

let app = express();
let router = express.Router();

// Very basic throwaway REST API

app.use('/api', router);

// API routes, aka resources and their URI
// GET request to /api/

router.get('/', (req, res) => {
    res.json({"message":"This is the response for your GET request to the root route of the API"});
});

// GET request to get all users : /api/users
router.get('/users', (req, res) => {
    // retrieve all users from a database.
    // convert the data to a json object
    let users = {users:dbData};
    res.json(users);
});

// add a user using a POST request to: api/users/add
router.post('/users/add', (req, res) => {
    // create new user using the user model.
    // save the new user into the database
    // send a confirmation message upon the success of the operation
    let message = 'User has been added!';
    res.json({"message":message});
});


